 * </module_context>
 */
$ccBase = '/plugins/unraid-connections';
$ccDir = '/usr/local/emhttp/plugins/unraid-connections';
$ccV = static fn(string $f): int => @filemtime("$ccDir/$f") ?: time();
$ccDark = in_array($display['theme'] ?? 'white', ['black', 'gray'], true);
?>
<link rel="stylesheet" href="<?= $ccBase ?>/assets/cc.css?v=<?= $ccV('assets/cc.css') ?>">
<div class="cc-root<?= $ccDark ? ' cc-dark' : '' ?>" id="cc-root">
