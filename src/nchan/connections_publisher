#!/usr/bin/php -q
<?php
/**
 * <module_context>
 *   <name>connections_publisher</name>
 *   <description>nchan script for the Connected Clients page (docs/specs/LIVE_UPDATES.md).
 *   The webGUI starts it when the page opens (page header Nchan="connections_publisher").
 *   It publishes state.json to the channel "connections" each time the collector writes it,
 *   or {"error":"collector_not_running"} when there is no snapshot. publish_noDupe() ends the
 *   script (and removes it from /var/run/nchan.pid) about 30 to 60 s after the last page
 *   closes. It also ends when this file is gone (uninstall).</description>
 *   <dependencies>webGui/include/publish.php, /tmp/unraid-connections/state.json</dependencies>
 * </module_context>
 */

declare(strict_types=1);

$docroot = $docroot ?? (($_SERVER['DOCUMENT_ROOT'] ?? '') ?: '/usr/local/emhttp');
require_once "$docroot/webGui/include/publish.php";

$state = '/tmp/unraid-connections/state.json';
$mtime = -1;
$msg = '';
while (is_file(__FILE__)) {
    clearstatcache(true, $state);
    $m = (int) @filemtime($state);
    if ($m !== $mtime || $msg === '') {
        $mtime = $m;
        $raw = $m > 0 ? @file_get_contents($state) : false;
        $msg = is_string($raw) && $raw !== '' ? $raw : '{"error":"collector_not_running"}';
    }
    publish_noDupe('connections', $msg, true);   // no subscriber for 30 s: the script exits
    sleep(1);
}
